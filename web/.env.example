# Kopieer naar .env.local en vul in. .env.local staat in .gitignore.
#
# Beide waarden staan in Supabase → Project Settings.
# LET OP: alleen de *Publishable* key hier. De Secret key (voorheen service_role)
# hoort uitsluitend in GitHub Secrets, nooit in de website.

NEXT_PUBLIC_SUPABASE_URL=https://<projectref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
